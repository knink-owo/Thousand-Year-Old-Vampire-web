{
  "name": "tyov-web",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:singlefile": "vue-tsc -b && vite build --config vite.config.singlefile.ts",
    "build:all": "npm run build && npm run build:singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.11"
  }
}
